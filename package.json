{
  "name": "webmap-overlay",
  "version": "2.0.0",
  "description": "Stormworks WebMap Overlay",
  "author": "sk7z",
  "main": "main.js",
  "build": {
    "appId": "xyz.sk7z.webmapoverlay",
    "productName": "WebMap Overlay",
    "artifactName": "WebMapOverlay-${version}-Installer.${ext}",
    "files": [
      "signed-updates.js",
      "update-signature.js",
      "update-trusted-keys.json",
      "path-safety.js",
      "main.js",
      "overlay-settings.js",
      "tracker-status.js",
      "window-tracker-script.js",
      "native-bridge.js",
      "preload.js",
      "config.html",
      "keybindings.html",
      "webmap_mini.png",
      "package.json",
      "!settings.json",
      "!user-data{,/**}",
      "!OverlayTracker{,/**}",
      "!dist{,/**}",
      "!scripts{,/**}",
      "!build{,/**}",
      "!start-overlay.bat",
      "!*.md"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "LICENSES.txt",
        "to": "LICENSES.txt"
      },
      {
        "from": "README.txt",
        "to": "README.txt"
      },
      {
        "from": "build/bin/WebMapOverlayWatcher.exe",
        "to": "WebMapOverlayWatcher.exe"
      },
      {
        "from": "native/build/Release/WebMapOverlayInjector.exe",
        "to": "WebMapOverlayInjector.exe"
      },
      {
        "from": "native/build/Release/WebMapOverlayHook.dll",
        "to": "WebMapOverlayHook.dll"
      },
      {
        "from": "native/build/Release/WebMapOverlayWriter.dll",
        "to": "WebMapOverlayWriter.dll"
      },
      {
        "from": "native/build/Release/MinHook-LICENSE.txt",
        "to": "MinHook-LICENSE.txt"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "webmap_mini.ico",
      "publish": {
        "provider": "github",
        "owner": "sk7z-xyz",
        "repo": "WebMapOverlay",
        "private": false
      }
    },
    "nsis": {
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": true
    }
  },
  "scripts": {
    "prepare-build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-build.ps1",
    "clean": "rimraf dist",
    "generate-licenses": "license-checker --production --csv --out LICENSES.txt && node scripts/append-minhook-license.js",
    "verify-package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-package.ps1",
    "dist": "npm run prepare-build && npm run generate-licenses && electron-builder --publish never && npm run verify-package",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "license-checker": "^25.0.1",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "3.2.1"
  },
  "allowScripts": {
    "koffi@3.2.1": true
  },
  "license": "MIT"
}
